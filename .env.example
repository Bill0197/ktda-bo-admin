# Sign-in and all live tokenization data go through the same-origin /tok proxy
# (vite.config.ts in dev, functions/tok on Cloudflare Pages) to the tokenization
# service. Override only to point the browser somewhere else.
# VITE_TOK_BASE=/tok
# VITE_OMNI_BASE=/omni

# Dev proxy targets (read by vite.config.ts, not the browser). Required, no
# default: unset, every /tok or /omni call answers 503. Put them in .env.local
# (git ignores it) or set them in the environment, which wins over the file;
# restart the dev server after a change. Never commit a real host.
# TOK_TARGET=https://<engine host>
# OMNI_TARGET=https://<omnichannel host>
# The same two names, set as Cloudflare Pages environment variables, are
# required by the deployed proxies too.

# CORE API (apps/core-api) is not deployed, so every page it would back runs on
# the in-browser demo data in src/mock. Set this at build time to switch those
# pages to the real CORE clients instead.
# VITE_CORE_API_BASE=http://localhost:8090
