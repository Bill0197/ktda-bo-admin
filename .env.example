# Sign-in and all live tokenization data go through the same-origin /tok proxy
# (vite.config.ts in dev, functions/tok on Cloudflare Pages) to the tokenization
# service. Override only to point the browser somewhere else.
# VITE_TOK_BASE=/tok
# VITE_OMNI_BASE=/omni

# Dev proxy targets (read by vite.config.ts, not the browser). Default: UAT.
# TOK_TARGET=https://tokenization-web-lb-1075088900.us-east-1.elb.amazonaws.com
# OMNI_TARGET=https://tokenization-omnichannel-lb-1369560458.us-east-1.elb.amazonaws.com
# The same two names, set as Cloudflare Pages environment variables, retarget
# the deployed proxies without a rebuild.

# CORE API (apps/core-api) is not deployed, so every page it would back runs on
# the in-browser demo data in src/mock. Set this at build time to switch those
# pages to the real CORE clients instead.
# VITE_CORE_API_BASE=http://localhost:8090
